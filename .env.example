# Flat Hub — Environment Configuration
# Copy this file to .env and fill in any values you want to customise.

# ── Server ────────────────────────────────────────────────────────────────────
# Port to run the server on (default 3000)
PORT=3000

# ── Location (dashboard weather + labels) ─────────────────────────────────────
LOCATION_NAME=My Location
LOCATION_REGION=
LOCATION_LATITUDE=51.5074
LOCATION_LONGITUDE=-0.1278
LOCATION_TIMEZONE=Europe/London

# Display label for tides card
TIDE_LOCATION_NAME=Local Harbour

# ── Tides (Admiralty API — most accurate, optional) ───────────────────────────
# Sign up for free at https://admiraltyapi.portal.azure-api.net/
# If set, Admiralty data is used instead of the local harmonic fallback.
ADMIRALTY_KEY=

# UKHO station ID for your tide location.
# Find yours at https://easytide.admiralty.co.uk/
TIDE_STATION_ID=

# ── Tides (local harmonic prediction fallback) ────────────────────────────────
# Mean Sea Level above Chart Datum (metres)
TIDE_Z0=2.90

# Optional JSON array of constituents: [[amplitude, speedDegPerHour, phaseDeg], ...]
# If omitted, defaults are used.
# TIDE_CONSTITUENTS_JSON=[[1.60,28.9841042,309.3],[0.65,30,160],[0.32,28.4397295,199.3],[0.17,30.0821373,0.9],[0.05,15.0410686,70.5],[0.03,13.9430356,193.8]]
