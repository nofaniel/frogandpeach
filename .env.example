ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- "your-admin-password"
ADMIN_PASSWORD_HASH=
APP_ORIGIN=http://localhost:8788
SETUP_TOKEN=
SESSION_TTL_DAYS=14

# Google Drive Gallery (optional — module hides without these)
# Create at https://console.cloud.google.com/apis/credentials
# Scopes: drive.readonly
# Redirect URI: https://your-app.pages.dev/api/gallery/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte hex key for encrypting tokens at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=
